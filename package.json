{
  "name": "encantos-mi-tierrita",
  "private": true,
  "version": "5.16.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:editor": "vite --config editor/vite.config.js --host 0.0.0.0 --port 3001",
    "build": "vite build",
    "build:editor": "vite build --config editor/vite.config.js",
    "preview": "vite preview",
    "test": "node --test",
    "build:artifact": "vite build && node tools/artifact-page.mjs",
    "balance": "node tools/balance-sim.js",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capgo/native-purchases": "8.9.2",
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "7.3.7"
  }
}
